# 复制为 .env 后填入真实值。.env 不入版本库。

# ---- LLM (DeepSeek) ----
# 必需。DeepSeek 控制台获取。
DEEPSEEK_API_KEY=
# 可选，默认见 backend/config.py
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 扇出档（高频低判断）与汇总评审档（低频高判断），对应 KTD3 的模型分层
LLM_MODEL_FLASH=deepseek-v4-flash
LLM_MODEL_PRO=deepseek-v4-pro

# ---- Embedding ----
# local | api  —— 对应 KTD4 的双 provider 抽象
EMBEDDING_PROVIDER=local

# EMBEDDING_PROVIDER=local 时使用。首次运行会下载模型。
EMBEDDING_LOCAL_MODEL=jinaai/jina-embeddings-v2-base-code

# EMBEDDING_PROVIDER=api 时必需。
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v3

# ---- 工作目录与限额 ----
# 克隆的仓库与索引落盘位置
WORKSPACE_ROOT=./.workspace
# 单文件解析体积上限（字节）
MAX_FILE_BYTES=1048576
# 扇出宽度上限，对应 KTD16
MAX_FANOUT_WIDTH=12

# ---- 可观测性（可选，对应 R25）----
# 留空则只用结构化日志
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codepilot-agent
LANGSMITH_TRACING=false

# ---- 可选：GitHub ----
# 不带 token 时 GitHub API 速率为 60 次/小时，且**私有仓库与不存在的仓库都返回 404**
# ——只有带 token 才能区分（403 vs 404）。开发期反复测试建议配上。
GITHUB_TOKEN=

# ---- 规模与并发（有默认值，通常不改）----

# 准入门限：可解析文件数上限。
# 实测参照：click 79 / fastapi 1142 / django 2929 / nest 1904 / refine 6810。
# TS 项目的文件数天然高于同规模 Python 项目，所以门限按 TS 那一档定。
#
# 调低它的唯一理由是想缩短单次分析时间：embedding 是唯一按量付费且线性增长的环节，
# 实测 fastapi 的 1138 个文件 → 719 块 → 索引 278s，8000 文件约 5000 块、约 32 分钟。
# 索引按 repo + commit + provider 缓存，同一 commit 的二次分析秒级命中。
MAX_PARSEABLE_FILES=8000

# 准入副门：git 对象总体积上限（KB）。默认 1.5GB。
# 报的是全量 git 对象体积，而实际做的是有界浅克隆，所以这道门拦的是「即使浅克隆也过大」
# 的情形（近期提交里有大体积二进制），而非真实下载量。
MAX_REPO_SIZE_KB=1500000

# 依赖图节点上限。超出则降级为目录级分组并在报告标注。
# 与 MAX_PARSEABLE_FILES 同值：依赖图是模块聚类的输入，目录级会把「哪些文件真的互相
# 依赖」这个信号预先折叠掉。两者不一致时，介于其间的仓库会拿到目录级架构视图。
MAX_GRAPH_NODES=8000

# 克隆深度。设 1 会让提交频次信号恒为空（Reviewer 的文件挑选依赖它）。
CLONE_DEPTH=200

# 同时在途的 LLM 请求数上限。
# 直连官方端点时可调高；经中转网关时实测 3 路并发就会触发上游超时（Cloudflare 524），
# 而重试全部撞在饱和的网关上会让模块分析失败。
LLM_MAX_CONCURRENCY=2

# 全进程的 LLM 在途请求总上限，跨全部访客凭证。
# 与 LLM_MAX_CONCURRENCY 是两个维度：后者是「同一凭证身份」的上限（约束单个上游网关的
# 压力），这一条约束本机出口总量。只有前者时，多个访客同时在跑总在途数没有上界。
LLM_GLOBAL_MAX_CONCURRENCY=4

# ---- 前端跨域（容器部署时由 compose 覆盖）----
# JSON 数组。不用通配符：这个 API 能触发克隆仓库与 LLM 调用，通配会让任意站点消耗这些资源。
# 公网部署时填实际域名，如 ["https://your.domain"]。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]

# ---- 公网部署（默认全部不必设置；只在对外开放时才动）----
#
# 容器端口的宿主绑定地址。**默认 127.0.0.1，即不对外。**
# 设为 0.0.0.0 才对外可达，而那之前应确认下面三项保护的阈值适合这台机器。
# 回滚就是删掉这一行并重启——一步可逆，落盘的分析历史不受影响。
# BIND_ADDR=0.0.0.0
# WEB_PORT=80

# 同一 IP 的提交限流：窗口内允许的次数与窗口长度（秒）。
# 一次分析要克隆、解析、向量化、跑十余次 LLM 调用，是分钟级的重活；3 次/小时对真实
# 评审者足够，对刷接口的脚本是硬墙。
# 前提：反代必须透传真实客户端 IP（X-Forwarded-For），否则全站共用一个配额。
SUBMISSIONS_PER_WINDOW=3
SUBMISSION_WINDOW_SECONDS=3600

# 同时在跑的分析任务数。超出的进队列而非被拒。
# 与 LLM_MAX_CONCURRENCY 不同物：这条是**任务数**，那条是 LLM **在途请求数**。
MAX_CONCURRENT_ANALYSES=2
# 排队上限。队列本身也是资源，排到几百位的等待没有意义。
MAX_QUEUED_ANALYSES=8

# 仓库工作副本的磁盘配额（字节）。默认 20GB。达到后按最近最少使用清理非在跑副本。
# 清理只删仓库副本，不删向量索引与落盘的分析历史。
REPOS_QUOTA_BYTES=21474836480
# 单次清理的最低回收量占配额的比例。低于它就不清理并报错——防止「清理与克隆互相追赶」，
# 让「配额太小以致放不下两个仓库」这类配置错误以明确失败暴露。
QUOTA_MIN_RECLAIM_RATIO=0.10
