# 复制为 .env 后填入真实值。.env 不入版本库。

# ---- LLM (DeepSeek) ----
# 必需。DeepSeek 控制台获取。
DEEPSEEK_API_KEY=
# 可选，默认见 backend/config.py
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 扇出档（高频低判断）与汇总评审档（低频高判断），对应 KTD3 的模型分层
LLM_MODEL_FLASH=deepseek-v4-flash
LLM_MODEL_PRO=deepseek-v4-pro

# ---- Embedding ----
# local | api  —— 对应 KTD4 的双 provider 抽象
EMBEDDING_PROVIDER=local

# EMBEDDING_PROVIDER=local 时使用。首次运行会下载模型。
EMBEDDING_LOCAL_MODEL=jinaai/jina-embeddings-v2-base-code

# EMBEDDING_PROVIDER=api 时必需。
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v3

# ---- 工作目录与限额 ----
# 克隆的仓库与索引落盘位置
WORKSPACE_ROOT=./.workspace
# 单仓库文件数上限，超出在克隆前拒绝
MAX_REPO_FILES=3000
# 单文件解析体积上限（字节）
MAX_FILE_BYTES=1048576
# 扇出宽度上限，对应 KTD16
MAX_FANOUT_WIDTH=12

# ---- 可观测性（可选，对应 R25）----
# 留空则只用结构化日志
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codepilot-agent
LANGSMITH_TRACING=false

# ---- 可选：GitHub ----
# 不带 token 时 GitHub API 速率为 60 次/小时，且**私有仓库与不存在的仓库都返回 404**
# ——只有带 token 才能区分（403 vs 404）。开发期反复测试建议配上。
GITHUB_TOKEN=

# ---- 规模与并发（有默认值，通常不改）----

# 准入门限：可解析文件数上限。
# 实测参照：click 79 / fastapi 1142 / django 2929。TS 项目的文件数天然高于同规模
# Python 项目（实测 nest 1904、refine 6810），分析 TS 大仓库时可能需要调高。
MAX_PARSEABLE_FILES=1500

# 准入副门：git 对象总体积上限（KB）。
MAX_REPO_SIZE_KB=300000

# 依赖图节点上限。超出则降级为目录级分组并在报告标注。
MAX_GRAPH_NODES=2000

# 克隆深度。设 1 会让提交频次信号恒为空（Reviewer 的文件挑选依赖它）。
CLONE_DEPTH=200

# 同时在途的 LLM 请求数上限。
# 直连官方端点时可调高；经中转网关时实测 3 路并发就会触发上游超时（Cloudflare 524），
# 而重试全部撞在饱和的网关上会让模块分析失败。
LLM_MAX_CONCURRENCY=2

# ---- 前端跨域（容器部署时由 compose 覆盖）----
# JSON 数组。不用通配符：这个 API 能触发克隆仓库与 LLM 调用，通配会让任意站点消耗这些资源。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]
