# spec-first:start
# host-local scratch and settings
.claude/tasks/
.claude/worktrees/
.qoder/settings.local.json

# spec-first local setup and workflow runtime artifacts
.spec-first/*.local.yaml
.spec-first/config.local.yaml
.spec-first/config/*.json
.spec-first/audits/
.spec-first/governance/
.spec-first/app-audit/
.spec-first/workflows/
.spec-first/workspace/
.spec-first/sessions/

# optional provider local artifacts
.codegraph/
graphify-out/
.graphify/
# spec-first:end

# ── 项目条目 ──

# 密钥。安全面明确要求 API key 不入代码库与镜像。
# .env.example 是模板，不含真实值，要入库。
.env
.env.*
!.env.example

# 工作区：克隆的仓库与向量索引。体积大且可重建。
# e2e 那份同类：里面是被分析仓库的克隆产物，还带嵌套 .git，入库会让本仓库套仓库。
.workspace/
.workspace-e2e/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# 前端
node_modules/
frontend/dist/
# tsc 的增量编译缓存，随机器与构建时刻变化。
*.tsbuildinfo

# 本地临时产物（实跑脚本、调试输出）
#
# **必须是 `_[^_]*` 而非 `_*`。** 后者同时命中每一个 `__init__.py`，于是 16 个包标记文件
# 从首个提交起就没进过仓库——本地跑全绿（文件在本地存在），而全新 checkout 里 `backend.tools`
# 退化成 namespace package，报的是 `ImportError: cannot import name 'TOOL_SCHEMAS' from
# 'backend.tools' (unknown location)`。那个 `(unknown location)` 是唯一线索。
#
# 这个缺陷只有全新 checkout 才暴露，是 CI 首次运行抓到的。`[^_]` 让首字符后必须是非下划线，
# 因此 `_probe.py` 仍被忽略而 `__init__.py`、`__main__.py` 不受影响。
_[^_]*.py
_[^_]*.txt
*.log
